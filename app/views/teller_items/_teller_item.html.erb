<%# locals: (teller_item:, visible_accounts:) %>

<%= tag.div id: dom_id(teller_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <%= render ProviderLogo.new(provider_key: :teller) %>

          <div class="pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p teller_item.name, class: "font-medium text-primary" %>
              <% if teller_item.scheduled_for_deletion? %>
                <p class="text-destructive text-sm animate-pulse"><%= t(".deletion_in_progress") %></p>
              <% end %>
            </div>
            <%# The institution belongs to every account on the connection, so it is
                shown only to a viewer who can see them all (#3630). %>
            <% if teller_item.accounts.any? && visible_accounts.size == teller_item.accounts.size %>
              <p class="text-xs text-secondary">
                <%= teller_item.institution_name %>
              </p>
            <% end %>
            <% if teller_item.syncing? %>
              <div class="text-secondary flex items-center gap-1">
                <%= icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span t(".syncing") %>
              </div>
            <% elsif teller_item.sync_error.present? %>
              <div class="text-secondary flex items-center gap-1">
                <%= render DS::Tooltip.new(text: teller_item.sync_error, icon: "alert-circle", size: "sm", color: "destructive", as: :span) %>
                <%= tag.span t(".error"), class: "text-destructive" %>
              </div>
            <% else %>
              <p class="text-secondary">
                <% if teller_item.last_synced_at %>
                  <%= t(".status_with_summary", timestamp: time_ago_in_words(teller_item.last_synced_at), summary: teller_item.sync_status_summary) %>
                <% else %>
                  <%= t(".status_never") %>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <div class="flex items-center gap-2">
            <% if Rails.env.development? %>
              <%= icon(
                "refresh-cw",
                as_button: true,
                href: sync_teller_item_path(teller_item)
              ) %>
            <% end %>

            <%= render DS::Menu.new do |menu| %>
              <% menu.with_item(
                variant: "button",
                text: t(".delete"),
                icon: "trash-2",
                href: teller_item_path(teller_item),
                method: :delete,
                confirm: CustomConfirm.for_resource_deletion(teller_item.name, high_severity: true)
              ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless teller_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: visible_accounts %>
        <% end %>

        <%# Sync summary (collapsible) - using shared ProviderSyncSummary component %>
        <% stats = teller_item.syncs.ordered.first&.sync_stats || {} %>
        <%= render ProviderSyncSummary.new(
          stats: stats,
          provider_item: teller_item,
          show_account_details: visible_accounts.size == teller_item.accounts.size
        ) %>

        <%# Use model methods for consistent counts %>
        <% unlinked_count = teller_item.unlinked_accounts_count %>
        <% linked_count = teller_item.linked_accounts_count %>
        <% total_count = teller_item.total_accounts_count %>

        <% if unlinked_count > 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".setup_needed") %></p>
            <p class="text-secondary text-sm"><%= t(".setup_description", linked: linked_count, total: total_count) %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "settings",
              variant: "primary",
              href: setup_accounts_teller_item_path(teller_item),
              frame: :modal
            ) %>
          </div>
        <% elsif teller_item.accounts.empty? && total_count == 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".no_accounts_title") %></p>
            <p class="text-secondary text-sm"><%= t(".no_accounts_description") %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "settings",
              variant: "primary",
              href: setup_accounts_teller_item_path(teller_item),
              frame: :modal
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
